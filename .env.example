# =============================================================================
#  .env.example — App Chuyền Treo (hanging_line_factory)
# =============================================================================
#
#  CÁCH SỬ DỤNG:
#    1. Copy file này thành `.env` (cùng thư mục):
#         Copy-Item .env.example .env        (PowerShell)
#         copy .env.example .env             (CMD)
#    2. Điền giá trị thực vào từng dòng bên dưới
#    3. KHÔNG commit file .env lên Git (đã có trong .gitignore)
#
#  Xem DEPLOY.md để biết hướng dẫn chi tiết từng bước.
# =============================================================================


# -----------------------------------------------------------------------------
# SQL SERVER — KẾT NỐI DATABASE NHÀ MÁY
# -----------------------------------------------------------------------------

# Tên instance SQL Server đang chạy trên máy này.
# Cú pháp:
#   .\SQLEXPRESS           -> SQL Server Express, instance mặc định, máy local
#   TENMAY\SQLEXPRESS      -> SQL Server Express trên máy khác trong mạng LAN
#   TENMAY\MSD             -> Named instance "MSD" trên máy khác
#   192.168.1.50\MSD       -> Theo IP, named instance MSD
#
# Kiểm tra instance đang chạy:
#   Get-Service -Name 'MSSQL*' | Select-Object Name, Status
HANGING_SQL_SERVER=.\SQLEXPRESS

# Tên database riêng của app (chứa schema app.*).
# Migration tự CREATE DATABASE nếu chưa tồn tại.
# Giữ mặc định trừ khi chạy nhiều app song song trên cùng máy.
HANGING_APP_DB=hanging_app

# Tên database MES — nguồn dữ liệu sản xuất, CHỈ ĐỌC.
# App truy vấn qua 3-part name: {MES_DB}.dbo.tXxx
# Thường là "MSD" — hỏi bộ phận IT nhà máy nếu khác.
HANGING_MES_DB=MSD

# ODBC Driver đã cài để kết nối SQL Server.
# Kiểm tra driver đang có:
#   Get-OdbcDriver | Where-Object Name -like "ODBC Driver*SQL Server*"
# Kết quả thường là "ODBC Driver 17 for SQL Server" hoặc "ODBC Driver 18 for SQL Server"
HANGING_SQL_DRIVER=ODBC Driver 17 for SQL Server


# -----------------------------------------------------------------------------
# QLCL — KẾT NỐI APP CHẤT LƯỢNG TRUNG TÂM
# -----------------------------------------------------------------------------

# Đơn vị sản xuất của app này — gắn vào prod_plan.don_vi khi đồng bộ kế hoạch sang QLCL.
# Mỗi XN đặt giá trị riêng để QLCL phân biệt dữ liệu từng xưởng.
# Ví dụ: XN1   XN2   XN3   XN1-V1
# >>> VÙNG A — ĐỔI MÃ XÍ NGHIỆP KHI NHÂN RỘNG <<<
QLCL_DON_VI=XN2
# >>> HẾT VÙNG A <<<

# URL của app QLCL trung tâm.
#   Dev local (cả hai app trên 1 máy): http://localhost:8008
#   Deploy thực tế (XN kết nối qua internet): https://qlcl.hachibavn.com
QLCL_API_URL=http://localhost:8008

# API key để xác thực với QLCL server khi đồng bộ kế hoạch.
# Phải trùng chính xác với QLCL_API_KEY được cấu hình bên QLCL server.
#
# CÁCH TẠO KEY (chạy 1 lần trên bất kỳ máy nào, lưu kết quả):
#   PowerShell:
#     [Convert]::ToBase64String((1..24 | ForEach-Object { Get-Random -Max 256 }))
#   Python:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Bắt buộc điền cùng key với QLCL cho API push và đọc QC của TV chuyền treo.
# QLCL phiên bản phân quyền mới từ chối API push nếu key trống.
QLCL_API_KEY=

# Tự động push kế hoạch sang QLCL theo định kỳ (không cần bấm thủ công).
#   true  → bật auto-sync (khuyến nghị cho production)
#   false → tắt, chỉ sync khi bấm nút trên Admin
QLCL_AUTO_SYNC_ENABLED=false

# Chu kỳ auto-sync kế hoạch (phút). Mặc định 60 phút = 1 tiếng.
QLCL_AUTO_SYNC_INTERVAL_MINUTES=60

# Bật/tắt sync sản lượng riêng (chu kỳ ngắn, chỉ push dữ liệu thay đổi).
# Mặc định: theo QLCL_AUTO_SYNC_ENABLED nếu không set riêng.
QLCL_OUTPUT_SYNC_ENABLED=true

# Chu kỳ sync sản lượng (giây). Mặc định 120 = 2 phút. Tối thiểu 30 giây.
QLCL_OUTPUT_SYNC_INTERVAL_SECONDS=120


# =============================================================================
# >>> VÙNG B — BẮT ĐẦU CẤU HÌNH NGUỒN CHUYỀN BỆT <<<
# CHUYỀN BỆT — NGUỒN GOOGLE SHEETS XN2
# =============================================================================
# Module đồng bộ Sheet vào database và dựng 4 TV chuyền bệt theo nhu cầu mẹ.
# Điền URL đầy đủ trong dấu nháy. Tab được chọn bằng *_WORKSHEET, không theo gid.
# Khi triển khai, QLCL_DON_VI phải cùng xí nghiệp với các nguồn bên dưới.
# Hướng dẫn đầy đủ: SETUP_CHUYEN_BET.md

# ĐƯỜNG DẪN JSON service account, không phải link Sheet hoặc nội dung JSON.
# Đường dẫn tương đối tính từ thư mục chứa .env; hoặc dùng D:/thu-muc/file.json.
# Chia sẻ quyền Viewer cho email client_email trong JSON trên cả hai file Sheet.
# Đặt JSON trong secrets/ để được loại khỏi Git.
FLAT_LINE_GOOGLE_SERVICE_ACCOUNT_FILE="secrets/credentials_m29.json"

# LINK 1: file THÔNG TIN MÃ HÀNG XN2 có các tab Rải chuyền và XN2.
# DÁN LINK FILE GOOGLE SHEETS, không dán link tab/dashboard riêng của một tổ.
# Link XN2 hiện hành:
FLAT_LINE_PLAN_SPREADSHEET_URL="https://docs.google.com/spreadsheets/d/1HvyqiIuV8gWXRpELT2UuSXoxNYYOuCCuC7ZtbfBBxK0/edit"
# Rải chuyền: nhu cầu mẹ, loại chuyền, ĐMKT, phân loại ĐH, SLKH, tổ, ngày rải.
# Hàng 2 là tiêu đề, dữ liệu bắt đầu hàng 3.
FLAT_LINE_PLAN_WORKSHEET="Rải chuyền"
FLAT_LINE_PLAN_RANGE="A2:M"
# Tab XN2: nhu cầu con, bảng PO/EHD và cấu hình tên 6 cụm.
# I = thông tin EHD; L = nhu cầu mẹ. Tên 6 cụm được tìm theo các tiêu đề
# 1 (KTĐM) ... 6 (KTĐM), kết hợp mã hàng và tổ để tránh lấy nhầm cấu hình.
FLAT_LINE_FACTORY_WORKSHEET="XN2"
FLAT_LINE_FACTORY_RANGE="A1:AE"

# LINK 2: file DATA GỐC theo dõi sản xuất 2 giờ XN2, có tab Data-U2.
# Không dùng link dashboard riêng của tổ. Link Data-U2 XN2 hiện hành:
FLAT_LINE_DATA_SPREADSHEET_URL="https://docs.google.com/spreadsheets/d/1CwFMTCavyyPwakm8k83y0WrErDivfI6muzj1vJeYbyc/edit"
FLAT_LINE_DATA_WORKSHEET="Data-U2"
# B = ngày báo cáo; C = tổ; D = nhu cầu con; E/F = lao động; G = mốc.
# H:L = 5 trạm đầu; BP = Quy đổi sản lượng (thay M); BV = Nhu cầu mẹ.
FLAT_LINE_DATA_RANGE="A1:BV"

# Bật sync lúc app khởi động và lặp lại theo số giây bên dưới.
# Chỉ ghi snapshot vào HANGING_APP_DB; giao diện TV không gọi Google Sheets trực tiếp.
FLAT_LINE_SYNC_ENABLED=true
FLAT_LINE_SYNC_INTERVAL_SECONDS=120

# TV3 chuyền bệt dùng chung QLCL_API_URL và QLCL_API_KEY ở trên.
# Ví dụ QLCL_API_URL=https://qlcl.hachibavn.com
# Không cần kết nối PostgreSQL trực tiếp từ hanging app.

# =============================================================================
# >>> HẾT VÙNG B <<<
# =============================================================================

# Cả 4 TV tổng hợp theo nhu cầu mẹ, lọc Chuyền bệt qua Rải chuyền.
# QC dùng QLCL; SAM và mục tiêu OWE dùng cấu hình app hiện có.
# 5 khoảng: 111,120,120,111,30 phút; tổng 492 phút.
# OWE lấy E+F mốc đầu ngày; dữ liệu hiển thị đến mốc báo cáo mới nhất.
